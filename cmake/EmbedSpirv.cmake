file(READ "${INPUT}" bytes HEX)
string(LENGTH "${bytes}" hex_length)
math(EXPR remainder "${hex_length} % 8")
if(NOT remainder EQUAL 0)
  message(FATAL_ERROR "SPIR-V must contain whole 32-bit words")
endif()
set(words "")
while(NOT bytes STREQUAL "")
  string(SUBSTRING "${bytes}" 0 2 b0)
  string(SUBSTRING "${bytes}" 2 2 b1)
  string(SUBSTRING "${bytes}" 4 2 b2)
  string(SUBSTRING "${bytes}" 6 2 b3)
  string(APPEND words "0x${b3}${b2}${b1}${b0}u,")
  string(SUBSTRING "${bytes}" 8 -1 bytes)
endwhile()
file(WRITE "${OUTPUT}" "#pragma once\n#include <cstdint>\nstatic constexpr std::uint32_t packed_binary_spirv[]={${words}};\n")
