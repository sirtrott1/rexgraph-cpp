@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(PkgConfig)
pkg_check_modules(GMPXX QUIET IMPORTED_TARGET gmpxx)
pkg_check_modules(GMP QUIET IMPORTED_TARGET gmp)
if(NOT GMPXX_FOUND OR NOT GMP_FOUND)
  set(RFC_FOUND FALSE)
  set(RFC_NOT_FOUND_MESSAGE "RFC requires the GMP and GMPXX development libraries")
  return()
endif()
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/RFCTargets.cmake")

set(RFC_Vulkan_FOUND FALSE)
set(RFC_SQLite_FOUND FALSE)
foreach(component IN LISTS RFC_FIND_COMPONENTS)
  if(component STREQUAL "Vulkan" AND @RFC_ENABLE_VULKAN@)
    find_dependency(Vulkan 1.1)
    include("${CMAKE_CURRENT_LIST_DIR}/RFCVulkanTargets.cmake")
    set(RFC_Vulkan_FOUND TRUE)
  elseif(component STREQUAL "SQLite" AND @RFC_ENABLE_SQLITE_INTERPRETATION@)
    find_dependency(SQLite3)
    if(NOT TARGET SQLite3::SQLite3 AND TARGET SQLite::SQLite3)
      add_library(SQLite3::SQLite3 ALIAS SQLite::SQLite3)
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/RFCSQLiteTargets.cmake")
    set(RFC_SQLite_FOUND TRUE)
  else()
    set(RFC_${component}_FOUND FALSE)
    set(RFC_NOT_FOUND_MESSAGE "RFC component '${component}' is unknown or was not built in this installation")
  endif()
endforeach()
check_required_components(RFC)
